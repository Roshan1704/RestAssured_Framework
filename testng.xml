<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RestAssured API Test Suite" parallel="false" thread-count="3" verbose="1">
    
    <listeners>
        <listener class-name="com.api.automation.listeners.ExtentReportListener"/>
        <listener class-name="com.api.automation.listeners.AllureListener"/>
        <listener class-name="com.api.automation.listeners.TestListener"/>
    </listeners>

    <test name="User API Tests">
        <classes>
            <class name="com.api.automation.tests.UserApiTests"/>
        </classes>
    </test>

    <test name="Authentication Tests">
        <classes>
            <class name="com.api.automation.tests.AuthenticationTests"/>
        </classes>
    </test>

    <test name="Data Driven Tests">
        <classes>
            <class name="com.api.automation.tests.DataDrivenTests"/>
        </classes>
    </test>

</suite>
